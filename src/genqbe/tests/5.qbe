type :Str = {l, l, }
type :GObject = {l, l, l, }
type :Record_1 = {}
type :Record_2 = {}
type :Record_3 = {}
type :Record_4 = {}
data $_stdout = { l $stdout }
function l $print(:Str %s) {
@start
	%str_data =l loadl %s
	# 64-bit architecture only lul
	%len_loc =l add %s, 8
	%str_len =w loadw %len_loc
	%stdout =l loadl $_stdout
	%res =w call $fwrite(l %str_data, w 1, w %str_len, l %stdout)
	ret 0
}

export function :Record_1 $MainModule.die() {
@start
	%_tmp_1 =:Record_2 call $exit (l 3)
	ret %_tmp_1
}
export function w $main() {
@start
	%_tmp_2 =:Record_4 call $MainModule.die ()
	ret %_tmp_2
}
