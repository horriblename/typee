type :Str = {l, l, }
type :GObject = {l, l, l, }
data $_stdout = { l $stdout }
function l $print(:Str %s) {
@start
	%str_data =l loadl %s
	# 64-bit architecture only lul
	%len_loc =l add %s, 8
	%str_len =w loadw %len_loc
	%stdout =l loadl $_stdout
	%res =w call $fwrite(l %str_data, w 1, w %str_len, l %stdout)
	ret 0
}

export function w $main() {
@start
	call $exit (l 2)
	ret 0
}
